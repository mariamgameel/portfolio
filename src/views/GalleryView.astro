---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryLightbox from '../components/GalleryLightbox.astro';
import Icon from '../components/Icon.astro';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const allGallery = await getCollection('gallery');
const sortedGallery = allGallery.sort((a, b) => a.data.order - b.data.order);

const categories = [
  { id: 'all', label: t('gallery.filterAll') },
  { id: 'Recognition', label: t('gallery.filterRecognition') },
  { id: 'Portrait', label: t('gallery.filterPortrait') },
  { id: 'Certificates', label: t('gallery.filterCertificates') },
  { id: 'Events', label: t('gallery.filterEvents') },
  { id: 'Projects', label: t('gallery.filterProjects') }
];
---

<BaseLayout
  lang={lang}
  title={`${t('gallery.title')} | Mariam Gameel`}
  description={t('gallery.subtitle')}
>
  <div class="space-y-8 pt-4 pb-16">
    <!-- Header -->
    <div class="space-y-2">
      <div class="inline-flex items-center gap-2 text-xs font-mono text-text-muted uppercase">
        <span>Media Archive</span>
        <span>•</span>
        <span>{sortedGallery.length} Items</span>
      </div>

      <h1 class="font-serif text-4xl sm:text-5xl font-bold text-text-primary">
        {t('gallery.title')}
      </h1>

      <p class="text-sm sm:text-base text-text-secondary max-w-2xl leading-relaxed">
        {t('gallery.subtitle')}
      </p>
    </div>

    <!-- Filter Buttons Bar -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 border-b border-border text-xs">
      {categories.map((cat, idx) => (
        <button
          type="button"
          class={`filter-gallery-btn px-4 py-1.5 rounded-full font-medium transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-silver shrink-0 ${
            idx === 0
              ? 'active-filter bg-ink text-marble-white dark:bg-white dark:text-ink font-semibold'
              : 'bg-mist/30 dark:bg-charcoal text-text-secondary hover:text-text-primary border border-border'
          }`}
          data-category={cat.id}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- Gallery Grid -->
    <div id="gallery-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedGallery.map((item) => {
        const title = lang === 'ar' && item.data.title_ar ? item.data.title_ar : item.data.title;
        const caption = lang === 'ar' && item.data.caption_ar ? item.data.caption_ar : item.data.caption;

        return (
          <div
            class="gallery-card bento-card rounded-2xl overflow-hidden group cursor-pointer border border-border flex flex-col justify-between"
            data-category={item.data.category}
            data-lightbox-src={item.data.image}
            data-lightbox-title={title}
            data-lightbox-caption={caption}
            data-lightbox-alt={item.data.alt}
            tabindex="0"
            role="button"
            aria-label={`View image: ${title}`}
          >
            <!-- Image Frame -->
            <div class="relative aspect-4/3 bg-mist/20 dark:bg-charcoal/50 overflow-hidden">
              <img
                src={item.data.image}
                alt={item.data.alt}
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                width="600"
                height="450"
              />
              <div class="absolute inset-0 bg-ink/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-marble-white text-xs font-semibold gap-1.5">
                <Icon name="zoom-in" class="w-4 h-4" />
                <span>Enlarge</span>
              </div>
            </div>

            <!-- Card Metadata -->
            <div class="p-4 space-y-1">
              <div class="flex items-center justify-between gap-2">
                <span class="px-2 py-0.5 rounded-full text-[9px] font-semibold uppercase tracking-wider bg-mist/50 dark:bg-charcoal text-text-secondary border border-border">
                  {item.data.category}
                </span>
                <span class="text-[10px] font-mono text-text-muted">{item.data.date}</span>
              </div>
              <h3 class="font-serif font-bold text-base text-text-primary group-hover:underline">
                {title}
              </h3>
              <p class="text-xs text-text-secondary line-clamp-2 leading-relaxed">
                {caption}
              </p>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Lightbox Accessible Modal -->
  <GalleryLightbox lang={lang} />
</BaseLayout>

<script>
  const galleryBtns = document.querySelectorAll('.filter-gallery-btn');
  const galleryCards = document.querySelectorAll<HTMLElement>('.gallery-card');

  galleryBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const category = btn.getAttribute('data-category') || 'all';

      galleryBtns.forEach((b) => {
        b.classList.remove('active-filter', 'bg-ink', 'text-marble-white', 'dark:bg-white', 'dark:text-ink', 'font-semibold');
        b.classList.add('bg-mist/30', 'dark:bg-charcoal', 'text-text-secondary', 'border', 'border-border');
      });

      btn.classList.add('active-filter', 'bg-ink', 'text-marble-white', 'dark:bg-white', 'dark:text-ink', 'font-semibold');
      btn.classList.remove('bg-mist/30', 'dark:bg-charcoal', 'text-text-secondary', 'border');

      galleryCards.forEach((card) => {
        const cardCategory = card.getAttribute('data-category');
        if (category === 'all' || cardCategory === category) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
