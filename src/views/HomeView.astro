---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ThreeHero from '../components/ThreeHero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CertificateCard from '../components/CertificateCard.astro';
import Icon from '../components/Icon.astro';
import { siteConfig, technicalStack } from '../data/site';
import { getLocalizedPath, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Content queries
const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const allCertificates = await getCollection('certificates', ({ data }) => !data.draft);
const featuredCertificates = allCertificates
  .filter((c) => c.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

// Computed stats (no hardcoded numbers)
const totalProjectsCount = allProjects.length;
const totalCertificatesCount = allCertificates.length;
const activeCertificatesCount = allCertificates.filter((c) => {
  if (!c.data.expiryDate) return true;
  return new Date(c.data.expiryDate) >= new Date();
}).length;
---

<BaseLayout lang={lang}>
  <!-- ==================== HERO SECTION ==================== -->
  <section class="space-y-8 pt-4 pb-12">
    <!-- Hero Container Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <!-- Left Column: Concise Narrative & CTAs -->
      <div class="lg:col-span-7 space-y-5">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-mist/40 dark:bg-charcoal text-text-secondary border border-border">
          <span class="w-2 h-2 rounded-full bg-status-success"></span>
          <span>{t('hero.badge')}</span>
        </div>

        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-text-primary leading-[1.12]">
          {lang === 'ar' ? siteConfig.name_ar : siteConfig.name}
        </h1>

        <p class="text-base sm:text-lg text-text-secondary font-medium leading-relaxed max-w-xl">
          {lang === 'ar' ? siteConfig.tagline_ar : siteConfig.tagline}
        </p>

        <!-- Primary Call to Actions -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a
            href={getLocalizedPath('/projects', lang)}
            class="px-5 py-2.5 rounded-full bg-ink text-marble-white dark:bg-white dark:text-ink font-semibold text-xs hover:opacity-90 transition-all flex items-center gap-2 shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-silver"
          >
            <span>{t('hero.viewProjects')}</span>
            <Icon name={lang === 'ar' ? 'arrow-left' : 'arrow-right'} class="w-3.5 h-3.5" />
          </a>

          <a
            href={siteConfig.cvUrl}
            download="Mariam_Gameel_CV.pdf"
            class="px-5 py-2.5 rounded-full border border-border hover:bg-mist/30 dark:hover:bg-charcoal/40 text-text-primary font-semibold text-xs transition-colors flex items-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-silver"
          >
            <Icon name="download" class="w-3.5 h-3.5" />
            <span>{t('hero.downloadCv')}</span>
          </a>

          <a
            href={getLocalizedPath('/contact', lang)}
            class="px-5 py-2.5 rounded-full hover:bg-mist/30 dark:hover:bg-charcoal/40 text-text-secondary hover:text-text-primary text-xs font-medium transition-colors"
          >
            {t('hero.contactMe')}
          </a>
        </div>

        <!-- Computed Metric Strip -->
        <div class="grid grid-cols-3 gap-4 pt-4 border-t border-border/70 max-w-md text-xs font-mono">
          <div>
            <div class="text-xl font-bold text-text-primary font-serif">{totalProjectsCount}</div>
            <div class="text-[10px] text-text-muted uppercase">Production Systems</div>
          </div>
          <div>
            <div class="text-xl font-bold text-text-primary font-serif">{totalCertificatesCount}</div>
            <div class="text-[10px] text-text-muted uppercase">Certifications</div>
          </div>
          <div>
            <div class="text-xl font-bold text-text-primary font-serif">{activeCertificatesCount}</div>
            <div class="text-[10px] text-text-muted uppercase">Active Cloud Certs</div>
          </div>
        </div>
      </div>

      <!-- Right Column: Lightweight 3D Monolith (Lazy loaded, no portraits) -->
      <div class="lg:col-span-5">
        <ThreeHero />
        <!-- Subtle text link to gallery per instructions -->
        <div class="text-center mt-3">
          <a
            href={getLocalizedPath('/gallery', lang)}
            class="text-[11px] text-text-muted hover:text-text-primary underline transition-colors"
          >
            {t('hero.seeGallery')} →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== FEATURED PROJECTS SECTION ==================== -->
  <section class="space-y-6 pt-8 pb-12 border-t border-border">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="font-serif text-3xl font-bold text-text-primary">
          {t('projects.featuredTitle')}
        </h2>
        <p class="text-xs text-text-muted mt-1">
          {t('projects.subtitle')}
        </p>
      </div>

      <a
        href={getLocalizedPath('/projects', lang)}
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-text-primary hover:underline"
      >
        <span>{t('projects.viewAll')}</span>
        <Icon name={lang === 'ar' ? 'arrow-left' : 'arrow-right'} class="w-3.5 h-3.5" />
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {featuredProjects.map((project) => (
        <ProjectCard project={project} lang={lang} />
      ))}
    </div>
  </section>

  <!-- ==================== HUMAN-CENTERED ENGINEERING TEASER ==================== -->
  <section class="bento-card rounded-3xl p-7 sm:p-9 my-8 border border-border relative overflow-hidden">
    <div class="max-w-2xl space-y-3">
      <div class="inline-flex items-center gap-2 text-xs font-mono text-text-muted uppercase tracking-wider">
        <Icon name="brain" class="w-4 h-4 text-text-primary" />
        <span>Cognitive Ergonomics & Architecture</span>
      </div>

      <h3 class="font-serif text-2xl sm:text-3xl font-bold text-text-primary">
        {t('about.storyTitle')}
      </h3>

      <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
        My academic background in Psychology directly shapes my engineering discipline: it provides a quantitative framework for analyzing user cognitive load, designing predictable API contracts, and writing defensive error-handling logic that prevents human error before it happens.
      </p>

      <div class="pt-2">
        <a
          href={getLocalizedPath('/about', lang)}
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-text-primary hover:underline"
        >
          <span>Read the engineering philosophy & background</span>
          <Icon name={lang === 'ar' ? 'arrow-left' : 'arrow-right'} class="w-3.5 h-3.5" />
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== CORE TECHNICAL STACK STRIP ==================== -->
  <section class="space-y-4 py-8 border-t border-border">
    <div class="flex items-center justify-between">
      <h3 class="font-serif text-2xl font-bold text-text-primary">
        Technical Stack
      </h3>
      <a
        href={getLocalizedPath('/about#stack', lang)}
        class="text-xs text-text-muted hover:text-text-primary underline"
      >
        View full matrix →
      </a>
    </div>

    <div class="flex flex-wrap gap-2">
      {technicalStack.map((item) => (
        <span class="px-3 py-1.5 rounded-full text-xs font-mono bg-mist/30 dark:bg-charcoal text-text-secondary border border-border">
          {item.name}
        </span>
      ))}
    </div>
  </section>

  <!-- ==================== LATEST VERIFIED CREDENTIALS STRIP ==================== -->
  <section class="space-y-6 py-8 border-t border-border">
    <div class="flex items-center justify-between">
      <div>
        <h3 class="font-serif text-2xl font-bold text-text-primary">
          {t('certificates.latestTitle')}
        </h3>
        <p class="text-xs text-text-muted mt-0.5">
          Amazon Web Services Official Verifications (Active through 2029)
        </p>
      </div>

      <a
        href={getLocalizedPath('/certificates', lang)}
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-text-primary hover:underline"
      >
        <span>{t('certificates.viewAll')}</span>
        <Icon name={lang === 'ar' ? 'arrow-left' : 'arrow-right'} class="w-3.5 h-3.5" />
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {featuredCertificates.map((cert) => (
        <CertificateCard cert={cert} lang={lang} />
      ))}
    </div>
  </section>

  <!-- ==================== BOTTOM CONTACT CTA ==================== -->
  <section class="text-center py-12 border-t border-border space-y-4">
    <h3 class="font-serif text-3xl font-bold text-text-primary">
      {lang === 'ar' ? 'جاهزون لبناء شيء استثنائي؟' : 'Ready to build something exceptional?'}
    </h3>
    <p class="text-xs sm:text-sm text-text-secondary max-w-md mx-auto">
      {t('contact.subtitle')}
    </p>
    <div>
      <a
        href={getLocalizedPath('/contact', lang)}
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-ink text-marble-white dark:bg-white dark:text-ink font-semibold text-xs hover:opacity-90 transition-all shadow-sm"
      >
        <Icon name="mail" class="w-4 h-4" />
        <span>{t('hero.contactMe')}</span>
      </a>
    </div>
  </section>
</BaseLayout>
