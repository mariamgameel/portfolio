---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../data/site';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title={`${t('contact.title')} | Mariam Gameel`}
  description={t('contact.subtitle')}
>
  <div class="space-y-8 pt-4 pb-16 max-w-4xl mx-auto">
    <!-- Header -->
    <div class="space-y-2">
      <div class="inline-flex items-center gap-2 text-xs font-mono text-text-muted uppercase">
        <span>Direct Communication</span>
        <span>•</span>
        <span>Open to Roles</span>
      </div>

      <h1 class="font-serif text-4xl sm:text-5xl font-bold text-text-primary">
        {t('contact.title')}
      </h1>

      <p class="text-sm sm:text-base text-text-secondary leading-relaxed max-w-2xl">
        {t('contact.subtitle')}
      </p>
    </div>

    <!-- Main Grid: Form + Quick Channels -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Contact Form -->
      <div class="lg:col-span-7">
        <ContactForm lang={lang} />
      </div>

      <!-- Quick Connect Sidebar -->
      <div class="lg:col-span-5 space-y-4">
        <!-- Direct Email Card -->
        <div class="bento-card rounded-2xl p-5 border border-border space-y-3">
          <div class="flex items-center gap-2 text-xs font-mono text-text-muted uppercase">
            <Icon name="mail" class="w-4 h-4 text-text-primary" />
            <span>Email Address</span>
          </div>
          <div class="font-bold text-sm text-text-primary break-all">
            {siteConfig.email}
          </div>
          <button
            id="copy-email-btn"
            type="button"
            class="w-full py-2 px-3 rounded-xl border border-border hover:bg-mist/30 dark:hover:bg-charcoal text-xs font-semibold text-text-primary transition-colors flex items-center justify-center gap-1.5 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-silver"
            data-email={siteConfig.email}
          >
            <Icon name="copy" class="w-3.5 h-3.5" />
            <span id="copy-text">{t('contact.copyEmail')}</span>
          </button>
        </div>

        <!-- Phone Card -->
        <div class="bento-card rounded-2xl p-5 border border-border space-y-2">
          <div class="flex items-center gap-2 text-xs font-mono text-text-muted uppercase">
            <Icon name="phone" class="w-4 h-4 text-text-primary" />
            <span>Phone / Mobile</span>
          </div>
          <div class="font-bold text-sm text-text-primary font-mono">
            {siteConfig.phone}
          </div>
          <p class="text-[11px] text-text-muted">Cairo, Egypt (UTC+2)</p>
        </div>

        <!-- Professional Profiles & CV -->
        <div class="bento-card rounded-2xl p-5 border border-border space-y-3 text-xs">
          <div class="font-mono text-text-muted uppercase text-[10px]">
            Profiles & Documents
          </div>

          <div class="space-y-2">
            <a
              href={siteConfig.github}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-2.5 rounded-xl border border-border hover:bg-mist/30 dark:hover:bg-charcoal text-text-primary transition-colors"
            >
              <div class="flex items-center gap-2 font-medium">
                <Icon name="github" class="w-4 h-4" />
                <span>GitHub</span>
              </div>
              <Icon name="arrow-up-right" class="w-3.5 h-3.5 text-text-muted" />
            </a>

            <a
              href={siteConfig.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-2.5 rounded-xl border border-border hover:bg-mist/30 dark:hover:bg-charcoal text-text-primary transition-colors"
            >
              <div class="flex items-center gap-2 font-medium">
                <Icon name="linkedin" class="w-4 h-4" />
                <span>LinkedIn</span>
              </div>
              <Icon name="arrow-up-right" class="w-3.5 h-3.5 text-text-muted" />
            </a>

            <a
              href={siteConfig.cvUrl}
              download="Mariam_Gameel_CV.pdf"
              class="flex items-center justify-between p-2.5 rounded-xl bg-ink text-marble-white dark:bg-white dark:text-ink font-semibold transition-opacity hover:opacity-90 shadow-sm"
            >
              <div class="flex items-center gap-2">
                <Icon name="download" class="w-4 h-4" />
                <span>Download Resume (PDF)</span>
              </div>
              <span class="text-[10px] font-mono opacity-80">166 KB</span>
            </a>

            {siteConfig.bookingUrl && (
              <a
                href={siteConfig.bookingUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between p-2.5 rounded-xl border border-border hover:bg-mist/30 dark:hover:bg-charcoal text-text-primary transition-colors"
              >
                <div class="flex items-center gap-2 font-medium">
                  <Icon name="calendar" class="w-4 h-4" />
                  <span>{t('contact.scheduleCall')}</span>
                </div>
                <Icon name="arrow-up-right" class="w-3.5 h-3.5 text-text-muted" />
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const copyText = document.getElementById('copy-text');

  copyBtn?.addEventListener('click', () => {
    const email = copyBtn.getAttribute('data-email');
    if (email) {
      navigator.clipboard.writeText(email).then(() => {
        if (copyText) copyText.textContent = 'Email copied!';
        setTimeout(() => {
          if (copyText) copyText.textContent = 'Copy Email Address';
        }, 2200);
      });
    }
  });
</script>
