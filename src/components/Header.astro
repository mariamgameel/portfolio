---
import Icon from './Icon.astro';
import { siteConfig } from '../data/site';
import { useTranslations, getLocalizedPath, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const t = useTranslations(lang);

const navItems = [
  { label: t('nav.projects'), href: getLocalizedPath('/projects', lang) },
  { label: t('nav.certificates'), href: getLocalizedPath('/certificates', lang) },
  { label: t('nav.gallery'), href: getLocalizedPath('/gallery', lang) },
  { label: t('nav.about'), href: getLocalizedPath('/about', lang) },
  { label: t('nav.contact'), href: getLocalizedPath('/contact', lang) },
];

const homeHref = getLocalizedPath('/', lang);
const normalize = (p: string) => p.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const cur = normalize(currentPath);
  const target = normalize(href);
  return cur === target || cur.startsWith(target + '/');
};

const targetLang: Lang = lang === 'en' ? 'ar' : 'en';
const langSwitchPath = getLocalizedPath(currentPath, targetLang);
---

<header class="sticky top-3 sm:top-5 z-50 w-full max-w-[1240px] mx-auto px-4 sm:px-6 pt-3 sm:pt-5">
  <nav
    class="bg-burgundy rounded-full ps-2 pe-2 sm:pe-3 py-2 flex items-center gap-3 sm:gap-6 shadow-marble-md"
    aria-label="Main Navigation"
  >
    <!-- Home circle -->
    <a
      href={homeHref}
      aria-label={t('nav.home')}
      aria-current={normalize(currentPath) === normalize(homeHref) ? 'page' : undefined}
      class="w-11 h-11 sm:w-[52px] sm:h-[52px] shrink-0 rounded-full border-2 border-[#E9DCC6] text-[#E9DCC6] flex items-center justify-center hover:bg-cream/10 transition-colors"
    >
      <Icon name="house" class="w-5 h-5 sm:w-6 sm:h-6" />
    </a>

    <!-- Identity -->
    <a href={homeHref} class="flex flex-col leading-tight min-w-0 no-underline">
      <span class="text-cream font-bold text-sm sm:text-[15px] truncate">
        {lang === 'ar' ? 'مريم جميل' : 'Mariam Gameel'}
      </span>
      <span class="text-latte text-[11px] truncate">
        {lang === 'ar' ? siteConfig.role_ar : siteConfig.role}
      </span>
    </a>

    <!-- Desktop links -->
    <div class="hidden lg:flex flex-1 items-center justify-center gap-1 xl:gap-2">
      {navItems.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class={`px-4 py-2 rounded-full text-sm font-semibold transition-colors ${
              active ? 'bg-cream text-burgundy' : 'text-cream hover:bg-cream/10'
            }`}
            aria-current={active ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </div>

    <div class="flex items-center gap-2 ms-auto lg:ms-0">
      <!-- Language toggle -->
      <a
        href={langSwitchPath}
        class="h-11 px-3.5 rounded-full border-2 border-latte/60 text-cream text-xs font-semibold flex items-center hover:bg-cream/10 transition-colors"
        aria-label={`Switch to ${targetLang === 'ar' ? 'Arabic' : 'English'}`}
      >
        {t('nav.langToggle')}
      </a>

      <!-- CV -->
      <a
        href={siteConfig.cvUrl}
        download="Mariam_Gameel_CV.pdf"
        class="hidden sm:inline-flex h-11 sm:h-12 items-center gap-2 px-5 whitespace-nowrap rounded-full bg-cream text-burgundy font-bold text-sm hover:bg-white transition-colors"
      >
        <Icon name="download" class="w-[18px] h-[18px]" />
        <span>{t('hero.downloadCv')}</span>
      </a>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden w-11 h-11 rounded-full bg-cream text-burgundy flex items-center justify-center"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu-drawer"
      >
        <Icon name="menu" class="w-5 h-5 menu-open-icon" />
        <Icon name="x" class="w-5 h-5 menu-close-icon hidden" />
      </button>
    </div>
  </nav>

  <!-- Mobile drawer -->
  <div id="mobile-menu-drawer" class="hidden lg:hidden mt-2 p-3 rounded-[28px] bg-burgundy shadow-marble-lg">
    <div class="flex flex-col gap-1">
      <a href={homeHref} class="px-4 py-3 rounded-2xl text-sm font-semibold text-cream hover:bg-cream/10">
        {t('nav.home')}
      </a>
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`px-4 py-3 rounded-2xl text-sm font-semibold ${
            isActive(item.href) ? 'bg-cream text-burgundy' : 'text-cream hover:bg-cream/10'
          }`}
        >
          {item.label}
        </a>
      ))}
      <a
        href={siteConfig.cvUrl}
        download="Mariam_Gameel_CV.pdf"
        class="mt-2 flex items-center justify-center gap-2 h-12 rounded-2xl text-sm font-bold bg-cream text-burgundy"
      >
        <Icon name="download" class="w-4 h-4" />
        <span>{t('hero.downloadCv')}</span>
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-menu-drawer');
  const openIcon = menuBtn?.querySelector('.menu-open-icon');
  const closeIcon = menuBtn?.querySelector('.menu-close-icon');

  const setOpen = (open: boolean) => {
    menuBtn?.setAttribute('aria-expanded', String(open));
    drawer?.classList.toggle('hidden', !open);
    openIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
  };

  menuBtn?.addEventListener('click', () => {
    setOpen(menuBtn.getAttribute('aria-expanded') !== 'true');
  });

  drawer?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));

  drawer?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      setOpen(false);
      menuBtn?.focus();
    }
  });
</script>
