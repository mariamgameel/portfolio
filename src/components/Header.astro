---
import Icon from './Icon.astro';
import { siteConfig } from '../data/site';
import { useTranslations, getLocalizedPath, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const t = useTranslations(lang);

const navItems = [
  { label: t('nav.home'), href: getLocalizedPath('/', lang) },
  { label: t('nav.projects'), href: getLocalizedPath('/projects', lang) },
  { label: t('nav.certificates'), href: getLocalizedPath('/certificates', lang) },
  { label: t('nav.gallery'), href: getLocalizedPath('/gallery', lang) },
  { label: t('nav.about'), href: getLocalizedPath('/about', lang) },
  { label: t('nav.contact'), href: getLocalizedPath('/contact', lang) },
];

const targetLang: Lang = lang === 'en' ? 'ar' : 'en';
const langSwitchPath = getLocalizedPath(currentPath, targetLang);
---

<header class="sticky top-4 z-50 max-w-5xl mx-auto px-4 w-full">
  <nav
    class="bento-card backdrop-blur-md bg-opacity-80 dark:bg-opacity-80 rounded-full px-4 sm:px-6 py-2.5 flex items-center justify-between border border-border"
    aria-label="Main Navigation"
  >
    <!-- Brand / Name -->
    <a
      href={getLocalizedPath('/', lang)}
      class="flex items-center gap-2 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-silver rounded-full p-1"
    >
      <div class="w-8 h-8 rounded-full bg-charcoal text-marble-white dark:bg-white dark:text-ink flex items-center justify-center font-mono text-xs font-bold transition-transform group-hover:scale-105">
        M
      </div>
      <div class="flex flex-col">
        <span class="font-serif font-bold text-sm tracking-wide text-text-primary">
          {lang === 'ar' ? siteConfig.name_ar : siteConfig.name}
        </span>
        <span class="text-[10px] text-text-muted font-mono tracking-wider uppercase hidden sm:inline">
          {lang === 'ar' ? siteConfig.role_ar : siteConfig.role}
        </span>
      </div>
    </a>

    <!-- Desktop Nav Links -->
    <div class="hidden lg:flex items-center gap-1 xl:gap-2">
      {navItems.map((item) => {
        const isActive =
          item.href === currentPath ||
          (item.href !== '/' && item.href !== '/ar/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`px-3 py-1.5 rounded-full text-xs font-medium transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-silver ${
              isActive
                ? 'bg-ink text-marble-white dark:bg-white dark:text-ink font-semibold'
                : 'text-text-secondary hover:text-text-primary hover:bg-mist/30 dark:hover:bg-charcoal/40'
            }`}
            aria-current={isActive ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </div>

    <!-- Controls (Status, Lang, Theme, CV, Mobile Menu) -->
    <div class="flex items-center gap-2">
      <!-- Open for Roles Status -->
      {siteConfig.openForRoles && (
        <span
          class="hidden xl:inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-medium bg-mist/40 dark:bg-charcoal/60 text-text-secondary border border-border"
          title="Available for Software Engineering opportunities"
        >
          <span class="w-2 h-2 rounded-full bg-status-success animate-pulse"></span>
          <span>{t('nav.openForRoles')}</span>
        </span>
      )}

      <!-- Language Toggle -->
      <a
        href={langSwitchPath}
        class="px-2.5 py-1 rounded-full text-xs font-medium border border-border hover:bg-mist/30 dark:hover:bg-charcoal/40 text-text-primary transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-silver"
        title="Switch language"
        aria-label={`Switch to ${targetLang === 'ar' ? 'Arabic' : 'English'}`}
      >
        {t('nav.langToggle')}
      </a>

      <!-- Theme Toggle -->
      <button
        id="theme-toggle-btn"
        type="button"
        class="w-8 h-8 rounded-full border border-border flex items-center justify-center text-text-secondary hover:text-text-primary hover:bg-mist/30 dark:hover:bg-charcoal/40 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-silver"
        aria-label={t('nav.themeToggle')}
      >
        <span class="dark:hidden">
          <Icon name="moon" class="w-4 h-4" />
        </span>
        <span class="hidden dark:inline">
          <Icon name="sun" class="w-4 h-4" />
        </span>
      </button>

      <!-- Download CV Button -->
      <a
        href={siteConfig.cvUrl}
        download="Mariam_Gameel_CV.pdf"
        class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-ink text-marble-white dark:bg-white dark:text-ink hover:opacity-90 transition-all shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-silver"
      >
        <Icon name="download" class="w-3.5 h-3.5" />
        <span>{t('nav.resume')}</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden w-8 h-8 rounded-full border border-border flex items-center justify-center text-text-primary hover:bg-mist/30 dark:hover:bg-charcoal/40 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-silver"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu-drawer"
      >
        <Icon name="menu" class="w-4 h-4 menu-open-icon" />
        <Icon name="x" class="w-4 h-4 menu-close-icon hidden" />
      </button>
    </div>
  </nav>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-menu-drawer"
    class="hidden lg:hidden mt-2 p-4 bento-card rounded-2xl border border-border backdrop-blur-xl bg-opacity-95 dark:bg-opacity-95 shadow-marble-lg"
  >
    <div class="flex flex-col gap-2">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="px-4 py-2.5 rounded-xl text-sm font-medium hover:bg-mist/30 dark:hover:bg-charcoal/40 text-text-primary transition-colors"
        >
          {item.label}
        </a>
      ))}
      <a
        href={siteConfig.cvUrl}
        download="Mariam_Gameel_CV.pdf"
        class="mt-2 flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold bg-ink text-marble-white dark:bg-white dark:text-ink"
      >
        <Icon name="download" class="w-4 h-4" />
        <span>{t('nav.resume')} (PDF)</span>
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile menu controller
  const menuBtn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-menu-drawer');
  const openIcon = menuBtn?.querySelector('.menu-open-icon');
  const closeIcon = menuBtn?.querySelector('.menu-close-icon');

  menuBtn?.addEventListener('click', () => {
    const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
    menuBtn.setAttribute('aria-expanded', String(!isExpanded));
    drawer?.classList.toggle('hidden');
    openIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });

  // Close drawer on link click or Escape
  drawer?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      drawer.classList.add('hidden');
      menuBtn?.setAttribute('aria-expanded', 'false');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    });
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !drawer?.classList.contains('hidden')) {
      drawer?.classList.add('hidden');
      menuBtn?.setAttribute('aria-expanded', 'false');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      menuBtn?.focus();
    }
  });

  // Theme toggle script
  const themeBtn = document.getElementById('theme-toggle-btn');
  themeBtn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.contains('dark');
    const newTheme = isDark ? 'light' : 'dark';
    document.documentElement.classList.toggle('dark', newTheme === 'dark');
    try {
      localStorage.setItem('theme', newTheme);
    } catch (e) {
      // localStorage disabled/restricted
    }
  });
</script>
