---
import Icon from './Icon.astro';
import { siteConfig } from '../data/site';
import { useTranslations, getLocalizedPath, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const t = useTranslations(lang);
const isAr = lang === 'ar';

const navItems = [
  { label: isAr ? 'المشاريع' : 'WORK', href: getLocalizedPath('/projects', lang) },
  { label: isAr ? 'عني' : 'ABOUT', href: getLocalizedPath('/about', lang) },
  { label: isAr ? 'الشهادات' : 'CERTIFICATES', href: getLocalizedPath('/certificates', lang) },
  { label: isAr ? 'المعرض' : 'GALLERY', href: getLocalizedPath('/gallery', lang) },
  { label: isAr ? 'تواصل' : 'CONTACT', href: getLocalizedPath('/contact', lang) },
];

const homeHref = getLocalizedPath('/', lang);
const normalize = (p: string) => p.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const cur = normalize(currentPath);
  const target = normalize(href);
  return cur === target || cur.startsWith(target + '/');
};

const targetLang: Lang = lang === 'en' ? 'ar' : 'en';
const langSwitchPath = getLocalizedPath(currentPath, targetLang);
---

<header class="sticky top-0 z-50 w-full bg-porcelain/95 backdrop-blur-md border-b border-border-light transition-all">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-8 py-5 flex items-center justify-between">
    <!-- Brand Monogram -->
    <a href={homeHref} class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-obsidian no-underline flex items-baseline gap-0.5">
      <span>{isAr ? 'م.ج' : 'MG'}</span>
      <span class="text-gold">.</span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-7 lg:gap-9" aria-label="Main Navigation">
      {navItems.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class={`font-sans text-[11px] font-semibold tracking-[0.18em] uppercase no-underline transition-colors ${
              active ? 'text-obsidian border-b border-obsidian pb-0.5' : 'text-neutral-500 hover:text-obsidian'
            }`}
            aria-current={active ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-3 sm:gap-4">
      <!-- Language Switcher -->
      <a
        href={langSwitchPath}
        class="font-mono text-[11px] font-medium tracking-wider text-gold-dark border border-border-light hover:border-gold px-2.5 py-1 rounded no-underline transition-colors uppercase"
        aria-label={`Switch to ${targetLang === 'ar' ? 'Arabic' : 'English'}`}
      >
        {isAr ? 'EN' : 'EN / AR'}
      </a>

      <!-- Download CV Button -->
      <a
        href={siteConfig.cvUrl}
        download="Mariam_Gameel_CV.pdf"
        class="hidden sm:inline-flex items-center gap-2 bg-obsidian text-porcelain hover:bg-gold-dark text-[11px] font-semibold tracking-[0.14em] uppercase px-4 py-2.5 rounded-sm no-underline transition-colors"
      >
        <Icon name="download" class="w-3.5 h-3.5" />
        <span>{t('hero.downloadCv')}</span>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden w-10 h-10 rounded-sm border border-border-light flex items-center justify-center text-obsidian hover:border-gold"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu-drawer"
      >
        <Icon name="menu" class="w-5 h-5 menu-open-icon" />
        <Icon name="x" class="w-5 h-5 menu-close-icon hidden" />
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu-drawer" class="hidden md:hidden border-t border-border-light bg-porcelain px-4 py-4 shadow-editorial-lg">
    <div class="flex flex-col gap-2">
      <a href={homeHref} class="px-3 py-2 text-xs font-semibold uppercase tracking-wider text-obsidian hover:text-gold">
        {t('nav.home')}
      </a>
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`px-3 py-2 text-xs font-semibold uppercase tracking-wider ${
            isActive(item.href) ? 'text-obsidian font-bold bg-neutral-100 rounded' : 'text-neutral-600 hover:text-obsidian'
          }`}
        >
          {item.label}
        </a>
      ))}
      <a
        href={siteConfig.cvUrl}
        download="Mariam_Gameel_CV.pdf"
        class="mt-2 flex items-center justify-center gap-2 h-11 text-xs font-semibold uppercase tracking-wider bg-obsidian text-porcelain rounded-sm"
      >
        <Icon name="download" class="w-4 h-4" />
        <span>{t('hero.downloadCv')}</span>
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-menu-drawer');
  const openIcon = menuBtn?.querySelector('.menu-open-icon');
  const closeIcon = menuBtn?.querySelector('.menu-close-icon');

  const setOpen = (open: boolean) => {
    menuBtn?.setAttribute('aria-expanded', String(open));
    drawer?.classList.toggle('hidden', !open);
    openIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
  };

  menuBtn?.addEventListener('click', () => {
    setOpen(menuBtn.getAttribute('aria-expanded') !== 'true');
  });

  drawer?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));

  drawer?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      setOpen(false);
      menuBtn?.focus();
    }
  });
</script>
