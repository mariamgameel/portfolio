---
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  name: string;
  class?: string;
  size?: number | string;
}

const { name, class: className = 'w-5 h-5', size = 20 } = Astro.props;

let svgContent = '';
try {
  const iconPath = path.join(process.cwd(), 'node_modules', 'lucide-static', 'icons', `${name}.svg`);
  if (fs.existsSync(iconPath)) {
    const raw = fs.readFileSync(iconPath, 'utf-8');
    // Inject size and classes into svg
    svgContent = raw
      .replace('<svg', `<svg class="${className}" width="${size}" height="${size}"`)
      .replace(/stroke="currentColor"/g, 'stroke="currentColor"');
  } else {
    // Fallback simple circle
    svgContent = `<svg class="${className}" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>`;
  }
} catch (e) {
  svgContent = `<svg class="${className}" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>`;
}
---

<Fragment set:html={svgContent} />
