---
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  name: string;
  class?: string;
  size?: number | string;
}

const { name, class: className = 'w-5 h-5', size = 20 } = Astro.props;

// Brand icons were removed from lucide-static, so they are kept inline here.
const brandIcons: Record<string, string> = {
  github:
    '<path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/>',
  linkedin:
    '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>'
};

const wrap = (inner: string) =>
  `<svg class="${className}" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${inner}</svg>`;

let svgContent = wrap('<circle cx="12" cy="12" r="10"/>');
if (brandIcons[name]) {
  svgContent = wrap(brandIcons[name]);
} else {
  try {
    const iconPath = path.join(process.cwd(), 'node_modules', 'lucide-static', 'icons', `${name}.svg`);
    if (fs.existsSync(iconPath)) {
      svgContent = fs
        .readFileSync(iconPath, 'utf-8')
        .replace('<svg', `<svg class="${className}" width="${size}" height="${size}" aria-hidden="true"`);
    }
  } catch {
    // keep fallback circle
  }
}
---

<Fragment set:html={svgContent} />
