---
import Icon from './Icon.astro';
import { siteConfig } from '../data/site';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const isAr = lang === 'ar';
---

<footer class="w-full bg-obsidian text-neutral-400 border-t border-border-dark py-8 sm:py-10">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-8 flex flex-col sm:flex-row items-center justify-between gap-6">
    <div class="flex items-center gap-3">
      <span class="font-serif text-2xl font-bold text-gold">M/G</span>
      <div class="h-4 w-px bg-border-dark"></div>
      <p class="text-xs font-mono tracking-wider text-neutral-400">
        © {new Date().getFullYear()} {isAr ? siteConfig.name_ar : siteConfig.name} · {isAr ? siteConfig.role_ar : siteConfig.role}
      </p>
    </div>

    <div class="flex items-center gap-3">
      <a
        href={siteConfig.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="w-9 h-9 rounded border border-border-dark text-neutral-300 hover:text-gold hover:border-gold flex items-center justify-center transition-colors"
      >
        <Icon name="github" class="w-4 h-4" />
      </a>
      <a
        href={siteConfig.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="w-9 h-9 rounded border border-border-dark text-neutral-300 hover:text-gold hover:border-gold flex items-center justify-center transition-colors"
      >
        <Icon name="linkedin" class="w-4 h-4" />
      </a>
      <a
        href={`mailto:${siteConfig.email}`}
        aria-label={siteConfig.email}
        class="w-9 h-9 rounded border border-border-dark text-neutral-300 hover:text-gold hover:border-gold flex items-center justify-center transition-colors"
      >
        <Icon name="mail" class="w-4 h-4" />
      </a>
    </div>
  </div>
  <p class="sr-only">{t('footer.rights')}</p>
</footer>
