---
import Icon from './Icon.astro';
import { siteConfig } from '../data/site';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer class="w-full max-w-[1240px] mx-auto px-4 sm:px-6 pb-10 pt-4">
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-[13px] text-wine">
    <p>
      © {new Date().getFullYear()} {lang === 'ar' ? siteConfig.name_ar : siteConfig.name} ·
      {lang === 'ar' ? siteConfig.role_ar : siteConfig.role}
    </p>
    <div class="flex items-center gap-2">
      <a
        href={siteConfig.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="w-11 h-11 rounded-full bg-burgundy text-cream flex items-center justify-center hover:bg-burgundy-dark transition-colors"
      >
        <Icon name="github" class="w-[18px] h-[18px]" />
      </a>
      <a
        href={siteConfig.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="w-11 h-11 rounded-full bg-burgundy text-cream flex items-center justify-center hover:bg-burgundy-dark transition-colors"
      >
        <Icon name="linkedin" class="w-[18px] h-[18px]" />
      </a>
      <a
        href={`mailto:${siteConfig.email}`}
        aria-label={siteConfig.email}
        class="w-11 h-11 rounded-full bg-burgundy text-cream flex items-center justify-center hover:bg-burgundy-dark transition-colors"
      >
        <Icon name="mail" class="w-[18px] h-[18px]" />
      </a>
    </div>
  </div>
  <p class="sr-only">{t('footer.rights')}</p>
</footer>
