---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { getLocalizedPath, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);

const { data, slug } = project;
const title = lang === 'ar' && data.title_ar ? data.title_ar : data.title;
const summary = lang === 'ar' && data.summary_ar ? data.summary_ar : data.summary;
const projectUrl = getLocalizedPath(`/projects/${slug}`, lang);
---

<article
  class="bento-card project-card-3d rounded-2xl p-6 sm:p-7 flex flex-col justify-between group relative overflow-hidden transition-all duration-300 hover:shadow-marble-md"
  style="perspective: 1000px;"
>
  <div>
    <!-- Top Header: Category & Deployment Status -->
    <div class="flex items-center justify-between gap-2 mb-3.5">
      <div class="flex items-center gap-1.5 flex-wrap">
        {data.category.map((cat) => (
          <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold uppercase tracking-wider bg-mist/50 dark:bg-charcoal text-text-secondary border border-border">
            {cat}
          </span>
        ))}
      </div>

      <span class="text-[11px] font-mono text-text-muted flex items-center gap-1 shrink-0">
        <span class="w-1.5 h-1.5 rounded-full bg-status-success"></span>
        <span>{data.status}</span>
      </span>
    </div>

    <!-- Title -->
    <h3 class="font-serif text-2xl font-bold text-text-primary group-hover:text-charcoal dark:group-hover:text-marble-white transition-colors">
      <a href={projectUrl} class="focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-silver rounded">
        {title}
      </a>
    </h3>

    <!-- Summary -->
    <p class="text-xs sm:text-sm text-text-secondary mt-2.5 leading-relaxed line-clamp-3">
      {summary}
    </p>

    <!-- Key Highlights / Badges -->
    {data.highlights.length > 0 && (
      <div class="mt-4 space-y-1.5 bg-mist/20 dark:bg-charcoal/40 rounded-xl p-3 border border-border/60 text-xs">
        {data.highlights.slice(0, 2).map((h) => (
          <div class="flex items-start gap-2">
            <Icon name={h.icon || 'check-circle'} class="w-3.5 h-3.5 text-text-primary shrink-0 mt-0.5" />
            <span class="text-text-secondary">
              <strong class="text-text-primary">{h.title}:</strong> {h.text}
            </span>
          </div>
        ))}
      </div>
    )}

    <!-- Tech Chips -->
    <div class="flex flex-wrap gap-1.5 mt-4">
      {data.tech.map((t) => (
        <span class="px-2 py-0.5 rounded bg-mist/40 dark:bg-charcoal/60 text-text-secondary font-mono text-[10px] border border-border/40">
          {t}
        </span>
      ))}
    </div>
  </div>

  <!-- Footer Link -->
  <div class="pt-5 mt-5 border-t border-border flex items-center justify-between text-xs">
    <span class="text-text-muted font-mono">{data.date}</span>
    <a
      href={projectUrl}
      class="inline-flex items-center gap-1.5 font-semibold text-text-primary hover:underline focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-silver rounded py-1 px-2"
    >
      <span>{t('projects.inspect')}</span>
      <Icon name={lang === 'ar' ? 'arrow-left' : 'arrow-right'} class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" />
    </a>
  </div>
</article>
