---
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const formEndpoint = process.env.PUBLIC_FORM_ENDPOINT || '';
---

<div class="bento-card rounded-3xl p-6 sm:p-8 border border-border">
  <form id="contact-form" class="space-y-4" data-endpoint={formEndpoint}>
    <!-- Honeypot anti-spam field -->
    <div class="hidden" aria-hidden="true">
      <input type="text" name="_honeypot" tabindex="-1" autocomplete="off" />
    </div>

    <!-- Name & Email Row -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="space-y-1.5">
        <label for="form-name" class="block text-xs font-semibold text-text-primary">
          {t('contact.nameLabel')} <span class="text-status-error">*</span>
        </label>
        <input
          id="form-name"
          type="text"
          name="name"
          required
          class="w-full px-3.5 py-2.5 rounded-xl bg-mist/30 dark:bg-charcoal/60 border border-border text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-silver transition-all"
          placeholder="Jane Doe"
        />
      </div>

      <div class="space-y-1.5">
        <label for="form-email" class="block text-xs font-semibold text-text-primary">
          {t('contact.emailLabel')} <span class="text-status-error">*</span>
        </label>
        <input
          id="form-email"
          type="email"
          name="email"
          required
          class="w-full px-3.5 py-2.5 rounded-xl bg-mist/30 dark:bg-charcoal/60 border border-border text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-silver transition-all"
          placeholder="jane@company.com"
        />
      </div>
    </div>

    <!-- Subject -->
    <div class="space-y-1.5">
      <label for="form-subject" class="block text-xs font-semibold text-text-primary">
        {t('contact.subjectLabel')} <span class="text-status-error">*</span>
      </label>
      <input
        id="form-subject"
        type="text"
        name="subject"
        required
        class="w-full px-3.5 py-2.5 rounded-xl bg-mist/30 dark:bg-charcoal/60 border border-border text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-silver transition-all"
        placeholder="Software Engineer Role / Project Inquiry"
      />
    </div>

    <!-- Message -->
    <div class="space-y-1.5">
      <label for="form-message" class="block text-xs font-semibold text-text-primary">
        {t('contact.messageLabel')} <span class="text-status-error">*</span>
      </label>
      <textarea
        id="form-message"
        name="message"
        rows="5"
        required
        class="w-full px-3.5 py-2.5 rounded-xl bg-mist/30 dark:bg-charcoal/60 border border-border text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-silver transition-all resize-y"
        placeholder="Hello Mariam, we would love to discuss a software engineering opportunity..."
      ></textarea>
    </div>

    <!-- Submit Button & Feedback -->
    <div class="pt-2">
      <button
        id="form-submit-btn"
        type="submit"
        class="w-full sm:w-auto px-6 py-3 rounded-full bg-ink text-marble-white dark:bg-white dark:text-ink font-semibold text-sm hover:opacity-90 transition-all flex items-center justify-center gap-2 shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-silver"
      >
        <Icon name="send" class="w-4 h-4" />
        <span id="btn-text">{t('contact.send')}</span>
      </button>
    </div>

    <!-- Live Status Announcement -->
    <div id="form-status" class="hidden text-xs rounded-xl p-3 border mt-3" aria-live="polite"></div>
  </form>
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('form-submit-btn') as HTMLButtonElement | null;
  const btnText = document.getElementById('btn-text');
  const statusDiv = document.getElementById('form-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const honeypot = (form.elements.namedItem('_honeypot') as HTMLInputElement)?.value;
    if (honeypot) {
      // Bot detected, silently abort
      return;
    }

    const endpoint = form.getAttribute('data-endpoint');
    if (!endpoint) {
      // Fallback mailto if no API endpoint configured
      const formData = new FormData(form);
      const subject = encodeURIComponent(String(formData.get('subject') || 'Portfolio Inquiry'));
      const body = encodeURIComponent(
        `Name: ${formData.get('name')}\nEmail: ${formData.get('email')}\n\n${formData.get('message')}`
      );
      window.location.href = `mailto:mariamgameel51@gmail.com?subject=${subject}&body=${body}`;
      return;
    }

    if (submitBtn) submitBtn.disabled = true;
    if (btnText) btnText.textContent = 'Sending...';
    if (statusDiv) {
      statusDiv.className = 'hidden';
      statusDiv.textContent = '';
    }

    try {
      const formData = new FormData(form);
      const response = await fetch(endpoint, {
        method: 'POST',
        body: formData,
        headers: { Accept: 'application/json' }
      });

      if (response.ok) {
        form.reset();
        if (statusDiv) {
          statusDiv.className = 'text-xs rounded-xl p-3 border bg-status-success/15 border-status-success/40 text-status-success font-medium mt-3';
          statusDiv.textContent = 'Thank you! Your message has been sent successfully.';
        }
      } else {
        throw new Error('Form submission failed');
      }
    } catch (err) {
      if (statusDiv) {
        statusDiv.className = 'text-xs rounded-xl p-3 border bg-status-error/15 border-status-error/40 text-status-error font-medium mt-3';
        statusDiv.textContent = 'Oops! There was an issue submitting your message. Please email directly at mariamgameel51@gmail.com.';
      }
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      if (btnText) btnText.textContent = 'Send Message';
    }
  });
</script>
