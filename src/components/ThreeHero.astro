---
// ThreeHero.astro - Lightweight lazy-loaded 3D marble geometric monolith
---

<div
  id="three-hero-container"
  class="relative w-full h-52 sm:h-64 rounded-2xl overflow-hidden bento-card marble-texture flex items-center justify-center border border-border"
  aria-label="Interactive 3D Monolith"
>
  <!-- Static Fallback Element (always rendered, hidden once 3D canvas fades in) -->
  <div id="three-fallback" class="flex flex-col items-center justify-center text-center p-6 select-none">
    <div class="w-16 h-16 rounded-2xl bg-mist/40 dark:bg-charcoal/60 border border-border flex items-center justify-center mb-2.5 shadow-sm">
      <div class="w-8 h-8 rounded-lg bg-charcoal dark:bg-marble-white transform rotate-45 transition-transform duration-700"></div>
    </div>
    <span class="text-xs font-mono text-text-secondary uppercase tracking-widest font-semibold">
      Software Architecture Monolith
    </span>
    <span class="text-[10px] text-text-muted mt-0.5">
      React • Laravel 12 • Node.js • AWS Cloud
    </span>
  </div>

  <!-- WebGL Canvas (Lazily activated) -->
  <canvas
    id="three-hero-canvas"
    class="absolute inset-0 w-full h-full opacity-0 transition-opacity duration-700 pointer-events-auto cursor-grab active:cursor-grabbing"
  ></canvas>
</div>

<script>
  // Lazy-load Three.js only when visible and reduced-motion is not requested
  const container = document.getElementById('three-hero-container');
  const canvas = document.getElementById('three-hero-canvas') as HTMLCanvasElement | null;
  const fallback = document.getElementById('three-fallback');

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (container && canvas && !prefersReducedMotion) {
    let renderer: any = null;
    let scene: any = null;
    let camera: any = null;
    let mesh: any = null;
    let isVisible = false;
    let animId = 0;
    let mouseX = 0;
    let mouseY = 0;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          isVisible = entry.isIntersecting;
          if (isVisible && !renderer) {
            initThree();
          }
        });
      },
      { threshold: 0.1 }
    );

    observer.observe(container);

    async function initThree() {
      try {
        const THREE = await import('three');

        const width = container!.clientWidth;
        const height = container!.clientHeight;

        scene = new THREE.Scene();
        camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 100);
        camera.position.z = 4.2;

        renderer = new THREE.WebGLRenderer({
          canvas: canvas!,
          alpha: true,
          antialias: true,
          powerPreference: 'low-power'
        });

        renderer.setSize(width, height);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

        const isDark = document.documentElement.classList.contains('dark');

        // Faceted Icosahedron Monolith (Low polygon count)
        const geometry = new THREE.IcosahedronGeometry(1.3, 0);
        const material = new THREE.MeshStandardMaterial({
          color: isDark ? 0x2b2b2e : 0xe8e8ea,
          roughness: 0.25,
          metalness: 0.65,
          flatShading: true
        });

        mesh = new THREE.Mesh(geometry, material);
        scene.add(mesh);

        // Environment Lights
        const ambientLight = new THREE.AmbientLight(0xffffff, isDark ? 0.7 : 1.1);
        scene.add(ambientLight);

        const dirLight = new THREE.DirectionalLight(0xffffff, isDark ? 1.4 : 1.8);
        dirLight.position.set(4, 5, 4);
        scene.add(dirLight);

        const rimLight = new THREE.DirectionalLight(isDark ? 0xa9a9ae : 0x6b6b70, 0.9);
        rimLight.position.set(-4, -3, -2);
        scene.add(rimLight);

        // Smooth fade-in
        canvas!.classList.remove('opacity-0');
        canvas!.classList.add('opacity-100');
        if (fallback) fallback.classList.add('opacity-0', 'pointer-events-none');

        // Pointer parallax interaction
        container!.addEventListener('pointermove', (e) => {
          const rect = container!.getBoundingClientRect();
          mouseX = ((e.clientX - rect.left) / rect.width - 0.5) * 2;
          mouseY = ((e.clientY - rect.top) / rect.height - 0.5) * 2;
        });

        container!.addEventListener('pointerleave', () => {
          mouseX = 0;
          mouseY = 0;
        });

        // Resize handler
        window.addEventListener('resize', onResize);

        function onResize() {
          if (!container || !renderer || !camera) return;
          const w = container.clientWidth;
          const h = container.clientHeight;
          camera.aspect = w / h;
          camera.updateProjectionMatrix();
          renderer.setSize(w, h);
        }

        // Render loop
        function animate() {
          if (isVisible && mesh) {
            mesh.rotation.y += 0.007;
            mesh.rotation.x += 0.004;

            // Target parallax
            mesh.rotation.y += (mouseX * 0.4 - mesh.rotation.y) * 0.04;
            mesh.rotation.x += (-mouseY * 0.4 - mesh.rotation.x) * 0.04;

            renderer.render(scene, camera);
          }
          animId = requestAnimationFrame(animate);
        }

        animate();
      } catch (err) {
        // WebGL failed or disabled: graceful fallback
        if (canvas) canvas.style.display = 'none';
        if (fallback) fallback.style.opacity = '1';
      }
    }
  }
</script>
