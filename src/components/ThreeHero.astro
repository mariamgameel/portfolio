---
// ThreeHero.astro - Interactive 3D Architectural Stack
// Lazy-loads Three.js with full fallback for reduced-motion and non-WebGL environments.
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div
  id="three-arch-stack"
  class={`relative w-[220px] h-[200px] sm:w-[260px] sm:h-[220px] flex items-center justify-center select-none ${className}`}
  aria-label="Interactive 3D Architectural Stack"
>
  <!-- Static Fallback SVG (Always rendered initially; hidden once 3D canvas fades in) -->
  <div id="three-arch-fallback" class="absolute inset-0 flex items-center justify-center transition-opacity duration-700">
    <svg width="150" height="130" viewBox="0 0 140 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="filter drop-shadow-[0_12px_24px_rgba(0,0,0,0.12)]">
      <!-- Base Gold Slab -->
      <path d="M70 70 L120 95 L70 120 L20 95 Z" fill="#BA9B70" />
      <path d="M20 95 L70 120 L70 114 L20 89 Z" fill="#977953" />
      <path d="M120 95 L70 120 L70 114 L120 89 Z" fill="#A88B60" />
      <!-- Middle Obsidian Slab -->
      <path d="M70 42 L120 67 L70 92 L20 67 Z" fill="#1A1A1E" />
      <path d="M20 67 L70 92 L70 86 L20 61 Z" fill="#111113" />
      <path d="M120 67 L70 92 L70 86 L120 61 Z" fill="#25252A" />
      <!-- Top White Marble Slab -->
      <path d="M70 14 L120 39 L70 64 L20 39 Z" fill="#FBF9F6" stroke="#E3DDD3" stroke-width="1" />
      <path d="M20 39 L70 64 L70 58 L20 33 Z" fill="#E6DFD4" />
      <path d="M120 39 L70 64 L70 58 L120 33 Z" fill="#EFE9DF" />
    </svg>
  </div>

  <!-- Interactive 3D WebGL Canvas -->
  <canvas
    id="three-arch-canvas"
    class="absolute inset-0 w-full h-full opacity-0 transition-opacity duration-700 cursor-grab active:cursor-grabbing z-10"
  ></canvas>

  <!-- Interactive Hover Layer Labels (Appear during exploded stack hover) -->
  <div id="stack-layer-labels" class="absolute -right-4 top-2 pointer-events-none opacity-0 transition-opacity duration-300 flex flex-col justify-between h-[150px] text-[10px] font-mono tracking-wider font-semibold text-gold-dark z-20">
    <span class="bg-porcelain/90 backdrop-blur-sm px-2 py-0.5 rounded border border-border-light shadow-sm">01 · FRONTEND & UX</span>
    <span class="bg-porcelain/90 backdrop-blur-sm px-2 py-0.5 rounded border border-border-light shadow-sm">02 · BACKEND & APIs</span>
    <span class="bg-porcelain/90 backdrop-blur-sm px-2 py-0.5 rounded border border-border-light shadow-sm">03 · CLOUD & DATA</span>
  </div>
</div>

<script>
  const container = document.getElementById('three-arch-stack');
  const canvas = document.getElementById('three-arch-canvas') as HTMLCanvasElement | null;
  const fallback = document.getElementById('three-arch-fallback');
  const labels = document.getElementById('stack-layer-labels');

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (container && canvas && !prefersReducedMotion) {
    let renderer: any = null;
    let scene: any = null;
    let camera: any = null;
    let stackGroup: any = null;
    let slabTop: any = null;
    let slabMid: any = null;
    let slabBase: any = null;
    let keyLight: any = null;

    let isVisible = false;
    let isHovered = false;
    let isDragging = false;
    let previousMousePosition = { x: 0, y: 0 };
    let rotationVelocity = { x: 0, y: 0 };

    let targetRotationX = 0.55; // Canonical isometric tilt
    let targetRotationY = -0.78;
    let currentRotationX = targetRotationX;
    let currentRotationY = targetRotationY;

    let targetExplode = 0; // 0 = docked, 1 = exploded view
    let currentExplode = 0;

    let mouseX = 0;
    let mouseY = 0;
    let animId = 0;
    let clock: any = null;

    // Observe visibility for lazy loading and performance pausing
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          isVisible = entry.isIntersecting;
          if (isVisible) {
            if (!renderer) {
              initThree();
            } else if (!animId) {
              clock.start();
              animate();
            }
          } else {
            if (animId) {
              cancelAnimationFrame(animId);
              animId = 0;
            }
          }
        });
      },
      { threshold: 0.1 }
    );

    observer.observe(container);

    async function initThree() {
      try {
        const THREE = await import('three');
        clock = new THREE.Clock();

        const width = container!.clientWidth || 260;
        const height = container!.clientHeight || 220;

        scene = new THREE.Scene();
        camera = new THREE.PerspectiveCamera(38, width / height, 0.1, 50);
        camera.position.set(0, 0, 7.2);

        renderer = new THREE.WebGLRenderer({
          canvas: canvas!,
          alpha: true,
          antialias: true,
          powerPreference: 'low-power'
        });

        renderer.setSize(width, height);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

        // Group holding all 3 slabs
        stackGroup = new THREE.Group();
        stackGroup.rotation.x = targetRotationX;
        stackGroup.rotation.y = targetRotationY;
        scene.add(stackGroup);

        // Helper to create beveled slab geometry
        function createSlabShape(size: number) {
          const shape = new THREE.Shape();
          const r = 0.15; // Corner roundness
          shape.moveTo(-size + r, -size);
          shape.lineTo(size - r, -size);
          shape.quadraticCurveTo(size, -size, size, -size + r);
          shape.lineTo(size, size - r);
          shape.quadraticCurveTo(size, size, size - r, size);
          shape.lineTo(-size + r, size);
          shape.quadraticCurveTo(-size, size, -size, size - r);
          shape.lineTo(-size, -size + r);
          shape.quadraticCurveTo(-size, -size, -size + r, -size);
          return shape;
        }

        const slabShape = createSlabShape(1.15);
        const extrudeSettings = {
          steps: 1,
          depth: 0.18,
          bevelEnabled: true,
          bevelThickness: 0.05,
          bevelSize: 0.05,
          bevelSegments: 3
        };

        const slabGeometry = new THREE.ExtrudeGeometry(slabShape, extrudeSettings);
        slabGeometry.center();
        slabGeometry.rotateX(Math.PI / 2); // Lay flat on XZ plane

        // 1. Top Slab: Polished Porcelain / Marble White (Frontend & Psychology)
        const topMaterial = new THREE.MeshPhysicalMaterial({
          color: 0xfbf9f6,
          metalness: 0.1,
          roughness: 0.2,
          clearcoat: 0.8,
          clearcoatRoughness: 0.15
        });
        slabTop = new THREE.Mesh(slabGeometry, topMaterial);
        slabTop.position.y = 0.52;
        stackGroup.add(slabTop);

        // 2. Middle Slab: Obsidian Graphite (Backend Architecture)
        const midMaterial = new THREE.MeshStandardMaterial({
          color: 0x18181b,
          metalness: 0.25,
          roughness: 0.45
        });
        slabMid = new THREE.Mesh(slabGeometry, midMaterial);
        slabMid.position.y = 0.0;
        stackGroup.add(slabMid);

        // 3. Base Slab: Brushed Antique Gold (Cloud, Infrastructure & Data)
        const baseMaterial = new THREE.MeshStandardMaterial({
          color: 0xba9b70,
          metalness: 0.85,
          roughness: 0.32
        });
        slabBase = new THREE.Mesh(slabGeometry, baseMaterial);
        slabBase.position.y = -0.52;
        stackGroup.add(slabBase);

        // Lighting setup
        const ambientLight = new THREE.AmbientLight(0xffffff, 1.4);
        scene.add(ambientLight);

        keyLight = new THREE.DirectionalLight(0xffeedd, 2.8);
        keyLight.position.set(4, 8, 6);
        scene.add(keyLight);

        const fillLight = new THREE.DirectionalLight(0xddeeff, 1.2);
        fillLight.position.set(-5, -2, -3);
        scene.add(fillLight);

        // Micro-interactions listeners
        setupInteractions();

        // Reveal canvas smoothly, hide SVG fallback
        requestAnimationFrame(() => {
          if (canvas) canvas.style.opacity = '1';
          if (fallback) fallback.style.opacity = '0';
        });

        animate();
      } catch (err) {
        console.warn('Three.js failed to initialize, keeping SVG fallback.', err);
      }
    }

    function setupInteractions() {
      // Hover exploded view
      container!.addEventListener('mouseenter', () => {
        isHovered = true;
        targetExplode = 1;
        if (labels) labels.style.opacity = '1';
      });

      container!.addEventListener('mouseleave', () => {
        isHovered = false;
        targetExplode = 0;
        if (labels) labels.style.opacity = '0';
      });

      // Mouse drag rotation
      canvas!.addEventListener('mousedown', (e) => {
        isDragging = true;
        previousMousePosition = { x: e.clientX, y: e.clientY };
      });

      window.addEventListener('mouseup', () => {
        isDragging = false;
      });

      window.addEventListener('mousemove', (e) => {
        const rect = container!.getBoundingClientRect();
        // Normalized cursor parallax (-1 to 1)
        mouseX = (e.clientX - (rect.left + rect.width / 2)) / (window.innerWidth / 2);
        mouseY = (e.clientY - (rect.top + rect.height / 2)) / (window.innerHeight / 2);

        if (isDragging) {
          const deltaX = e.clientX - previousMousePosition.x;
          const deltaY = e.clientY - previousMousePosition.y;

          rotationVelocity.x = deltaY * 0.008;
          rotationVelocity.y = deltaX * 0.008;

          targetRotationX += rotationVelocity.x;
          targetRotationY += rotationVelocity.y;

          previousMousePosition = { x: e.clientX, y: e.clientY };
        }
      });

      // Resize listener
      window.addEventListener('resize', () => {
        if (!renderer || !camera) return;
        const width = container!.clientWidth || 260;
        const height = container!.clientHeight || 220;
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
        renderer.setSize(width, height);
      });
    }

    function animate() {
      animId = requestAnimationFrame(animate);

      const elapsedTime = clock ? clock.getElapsedTime() : 0;

      // 1. Gentle ambient levitation (breathing)
      const hoverFloat = Math.sin(elapsedTime * 1.5) * 0.06;
      stackGroup.position.y = hoverFloat;

      // 2. Exploded stack vertical separation on hover
      currentExplode += (targetExplode - currentExplode) * 0.1;
      slabTop.position.y = 0.52 + currentExplode * 0.55;
      slabMid.position.y = 0.0;
      slabBase.position.y = -0.52 - currentExplode * 0.4;

      // 3. Parallax tilt tracking (when not dragging)
      if (!isDragging) {
        const parallaxTargetX = 0.55 + mouseY * 0.25;
        const parallaxTargetY = -0.78 + mouseX * 0.35;
        targetRotationX += (parallaxTargetX - targetRotationX) * 0.05;
        targetRotationY += (parallaxTargetY - targetRotationY) * 0.05;
      }

      currentRotationX += (targetRotationX - currentRotationX) * 0.08;
      currentRotationY += (targetRotationY - currentRotationY) * 0.08;

      stackGroup.rotation.x = currentRotationX;
      stackGroup.rotation.y = currentRotationY;

      // Dynamic light tracking
      if (keyLight) {
        keyLight.position.x = 4 + mouseX * 3;
        keyLight.position.y = 8 - mouseY * 3;
      }

      renderer.render(scene, camera);
    }
  }
</script>
