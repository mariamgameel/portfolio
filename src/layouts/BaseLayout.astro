---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../data/site';
import { getLocalizedPath, type Lang } from '../i18n/utils';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, any>;
}

const {
  title = `${siteConfig.name} | ${siteConfig.role}`,
  description = siteConfig.tagline,
  lang = 'en',
  image = '/og-image.png',
  type = 'website',
  jsonLd
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://mariamgameel.github.io';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const enUrl = new URL(getLocalizedPath(Astro.url.pathname, 'en'), siteUrl).toString();
const arUrl = new URL(getLocalizedPath(Astro.url.pathname, 'ar'), siteUrl).toString();

const isRtl = lang === 'ar';

// Default Person Schema
const defaultPersonSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteConfig.name,
  jobTitle: siteConfig.role,
  url: siteUrl,
  email: siteConfig.email,
  sameAs: [siteConfig.github, siteConfig.linkedin],
  knowsLanguage: ['Arabic', 'English', 'Turkish', 'French', 'Spanish'],
  alumniOf: [
    {
      '@type': 'EducationalOrganization',
      name: 'Digilians Specialized Diploma in AI-Based Software Development'
    },
    {
      '@type': 'EducationalOrganization',
      name: 'Suez Canal University'
    }
  ]
};

const structuredData = jsonLd || defaultPersonSchema;
---

<!doctype html>
<html lang={lang} dir={isRtl ? 'rtl' : 'ltr'} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Language Alternates / Hreflang -->
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="ar" href={arUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <!-- Favicon Set -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0B0B0C" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Anti-flash inline theme script -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Optional Privacy-First Analytics (No cookies) -->
    {siteConfig.analyticsDomain && (
      <script
        defer
        data-domain={siteConfig.analyticsDomain}
        src="https://plausible.io/js/script.js"
      />
    )}
  </head>
  <body class="min-h-screen bg-bg text-text-primary antialiased flex flex-col selection:bg-charcoal selection:text-marble-white dark:selection:bg-silver dark:selection:text-ink">
    <!-- Skip to main content for accessibility -->
    <a href="#main-content" class="skip-link">
      {lang === 'ar' ? 'تخطي إلى المحتوى الرئيسي' : 'Skip to main content'}
    </a>

    <!-- Procedural Marble SVG Filter (Veined Displacement) -->
    <svg class="sr-only" aria-hidden="true" width="0" height="0">
      <filter id="marble-vein-filter">
        <feTurbulence type="fractalNoise" baseFrequency="0.012" numOctaves="4" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="8" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>

    <!-- Header Navigation -->
    <Header lang={lang} currentPath={Astro.url.pathname} />

    <!-- Main Content Slot -->
    <main id="main-content" class="flex-1 w-full max-w-5xl mx-auto px-4 py-8">
      <slot />
    </main>

    <!-- Footer -->
    <Footer lang={lang} />
  </body>
</html>
