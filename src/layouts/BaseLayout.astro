---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../data/site';
import { getLocalizedPath, type Lang } from '../i18n/utils';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, any>;
  fullWidth?: boolean;
  hideFooter?: boolean;
}

const {
  title = `${siteConfig.name} | ${siteConfig.role}`,
  description = siteConfig.tagline,
  lang = 'en',
  image = '/og-image.png',
  type = 'website',
  jsonLd,
  fullWidth = false,
  hideFooter = false
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://mariamgameel.github.io';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const enUrl = new URL(getLocalizedPath(Astro.url.pathname, 'en'), siteUrl).toString();
const arUrl = new URL(getLocalizedPath(Astro.url.pathname, 'ar'), siteUrl).toString();

const isRtl = lang === 'ar';

// Default Person Schema
const defaultPersonSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteConfig.name,
  jobTitle: siteConfig.role,
  url: siteUrl,
  email: siteConfig.email,
  sameAs: [siteConfig.github, siteConfig.linkedin],
  knowsLanguage: ['Arabic', 'English', 'Turkish', 'French', 'Spanish'],
  alumniOf: [
    {
      '@type': 'EducationalOrganization',
      name: 'Digilians Specialized Diploma in AI-Based Software Development'
    },
    {
      '@type': 'EducationalOrganization',
      name: 'Suez Canal University'
    }
  ]
};

const structuredData = jsonLd || defaultPersonSchema;
---

<!doctype html>
<html lang={lang} dir={isRtl ? 'rtl' : 'ltr'} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Language Alternates / Hreflang -->
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="ar" href={arUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <!-- Favicon Set -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#FAF8F5" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Optional Privacy-First Analytics -->
    {siteConfig.analyticsDomain && (
      <script
        defer
        data-domain={siteConfig.analyticsDomain}
        src="https://plausible.io/js/script.js"
      />
    )}
  </head>
  <body class="min-h-screen bg-porcelain text-text-primary antialiased flex flex-col selection:bg-gold/30 selection:text-obsidian">
    <!-- Skip to main content for accessibility -->
    <a href="#main-content" class="skip-link">
      {lang === 'ar' ? 'تخطي إلى المحتوى الرئيسي' : 'Skip to main content'}
    </a>

    <!-- Header Navigation -->
    <Header lang={lang} currentPath={Astro.url.pathname} />

    <!-- Main Content Slot -->
    {fullWidth ? (
      <main id="main-content" class="flex-1 w-full">
        <slot />
      </main>
    ) : (
      <main id="main-content" class="flex-1 w-full max-w-[1240px] mx-auto px-4 sm:px-8 py-8 sm:py-12">
        <slot />
      </main>
    )}

    <!-- Global Footer -->
    {!hideFooter && <Footer lang={lang} />}
  </body>
</html>
